# Postgres (su Coolify: URL interno del servizio database)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password dell'area /admin
ADMIN_PASSWORD=cambiala

# Segreto per firmare il cookie di sessione (opzionale ma consigliato)
AUTH_SECRET=

# Porta (Coolify la inietta, di solito 3000)
PORT=3000
